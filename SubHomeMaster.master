<%@ Master Language="C#" MasterPageFile="~/HomeMaster.master" AutoEventWireup="true"
    CodeFile="SubHomeMaster.master.cs" Inherits="SubHomeMaster" %>

<asp:Content ID="Content1" ContentPlaceHolderID="head" runat="Server">

    
    <asp:ContentPlaceHolder ID="ContentPlaceHolderSubMasterHead" runat="server">
    </asp:ContentPlaceHolder>
</asp:Content>
<asp:Content ID="Content2" ContentPlaceHolderID="ContentPlaceHolder1" runat="Server">
    

	
	<asp:ContentPlaceHolder id="ContentPlaceHolderSubMasterBody" runat="server">
        
        </asp:ContentPlaceHolder>
   
	  
		
    <asp:Repeater ID="RepeaterSideHome" Visible="false" runat="server">
        <ItemTemplate>
            <div class="person_profile">
                <div class="pp_red">
                    <h1>
                        <%# Eval("Head") %></h1>
                    <div class="profile_img">
                        <a href="Testimonials.aspx">
                            <img style="width:78px; height:85px;" src='<%# Eval("ImagePath") %>'></a></div>
                    <div class="profile_dsc_red">
                        <b><%# Eval("Name") %></b><br>
                        <%# Eval("State") %>, <%# Eval("Country") %></div>
                    <div class="profile_quote">
                        "<%# Eval("GALLERYDESC")%>"</div>
                    <div class="action">
                        <a href="Testimonials.aspx" class="btn_sm_red"><span><span>More Testimonials</span></span></a></div>
                    <div class="clear">
                    </div>
                </div>
            </div>
        </ItemTemplate>
    </asp:Repeater>

	
    	



 
</asp:Content>
