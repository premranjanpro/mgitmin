  <system.web>

    <machineKey validationKey="6908E9C9296603BF5C0F186D8AC143D5E8D916F178A7196B3C11AE899AEBA104611FF0D6FFE62C15444D34BE68CAAB4FE327F0A869EE76930F857399E588E3F4" decryptionKey="8FE0F1B1C34FEE0D11258E9BAB77F2CC3924D53552631FCD96366708CEE189AD" validation="SHA1" decryption="AES" />

