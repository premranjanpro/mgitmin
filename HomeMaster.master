                                    <h4>3 Year</h4>
                                    <span> Courses</span> </div>
                                <a href="#"><span class="icon-more-icon"></span></a> </div>
                        </div>
                    </li>
                    <li>
                        <div class="inner">
                            <figure><img src="images/course-img4.jpg" alt=""></figure>
                            <h3>Teaching   <span>& </span><span>Soft Skills</span></h3>
                            <p>Diploma in NTT, Advance Diploma in NTT</p>
                            <div class="bottom-txt clearfix">
                                <div class="duration">
                                    <h4>2 Year</h4>
                                    <span> Courses</span> </div>
                                <a href="#"><span class="icon-more-icon"></span></a> </div>
